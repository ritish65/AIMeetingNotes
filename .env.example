# Application environment (development | production)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# APP_SECRET=  # Auto-generated if not set; set a strong value in production
DATABASE_URL=sqlite+aiosqlite:///./pmia.db
DATA_DIR=./data
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# LLM provider (openai | anthropic | groq | stub)
LLM_PROVIDER=stub
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Speech-to-text backend (faster-whisper | openai | stub)
STT_BACKEND=stub
# WHISPER_MODEL=base.en
# WHISPER_DEVICE=cpu

# Qdrant vector DB
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Human-in-the-loop: set to true to auto-execute tool actions
AUTOPILOT=false

# Todoist integration
# TODOIST_TOKEN=

# Gmail integration
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_FROM=

# Google Calendar integration
# GCAL_CLIENT_ID=
# GCAL_CLIENT_SECRET=
# GCAL_REFRESH_TOKEN=
# GCAL_CALENDAR_ID=primary
